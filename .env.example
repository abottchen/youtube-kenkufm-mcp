# kenkufm-youtube-mcp configuration.
# Copy this file to .env (which is gitignored) and fill in your values:
#   cp .env.example .env
# These values are loaded into the environment at startup; any real environment
# variable of the same name takes precedence over the file.

# Required: bearer token for the MCP HTTP endpoint (16+ chars).
# Generate one with:  openssl rand -hex 32
YOUTUBE_MCP_AUTH_TOKEN=

# Optional (defaults shown):
#YOUTUBE_MCP_PORT=3940
#YOUTUBE_MCP_HOST=127.0.0.1
#KENKU_CDP_URL=http://localhost:9222
#YOUTUBE_VIEW_URL_MATCH=youtube.com
#LOG_LEVEL=INFO
