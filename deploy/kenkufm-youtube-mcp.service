[Unit]
Description=kenkufm-youtube-mcp (control YouTube in Kenku FM via CDP)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/youtube-mcp
# Config is read from the .env file in WorkingDirectory (see .env.example)
ExecStart=%h/projects/youtube-mcp/.venv/bin/python -m kenkufm_youtube_mcp
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
